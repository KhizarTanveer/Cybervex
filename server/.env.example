# Copy this file to server/.env and fill it in. server/.env is git-ignored — never commit it.

# MongoDB connection. Local MongoDB (what Compass connects to on this computer):
MONGODB_URI=mongodb://localhost:27017
# For MongoDB Atlas use the string from Atlas → Connect, e.g.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# Database name (shown in Compass)
MONGODB_DB=cybervex

# Admin panel login (/admin)
ADMIN_EMAIL=
# Run `npm run hash-password` and paste the line it prints. The password itself is never stored.
ADMIN_PASSWORD_HASH=
# (Local development only: a plain ADMIN_PASSWORD= also works; it is ignored in production.)

# Long random text (at least 32 characters) that signs admin login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# API server port (the website dev server forwards /api here)
PORT=4000

# Email notifications for Contact messages and job applications (Titan Mail shown).
# The team gets each submission (applications with the resume attached); the visitor gets a
# short confirmation. Leave SMTP_PASS empty to turn emails off.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@cybervexdigital.com
# Wrap in single quotes if the password contains quotes, # or spaces
SMTP_PASS=
MAIL_FROM_NAME=Cybervex Digital
# Where notifications go (defaults to SMTP_USER)
NOTIFY_TO=info@cybervexdigital.com

# --- Production (VPS) only ---
# NODE_ENV=production
# Which proxies may report the visitor's real IP (used for the sign-in and form limits):
#   loopback = Nginx on the same server in front of this app
#   2        = Vercel -> Nginx -> this app
# Leave unset when nothing is in front of the app.
# TRUST_PROXY=loopback
